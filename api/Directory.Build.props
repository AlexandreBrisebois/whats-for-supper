<Project>
  <!-- Centralise the EF Core version to avoid transitive version conflicts
       with the Npgsql provider. Both projects inherit this override. -->
  <ItemGroup>
    <PackageReference Update="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0-preview.6.26359.118" />
    <PackageReference Update="Microsoft.EntityFrameworkCore.Relational.Design" Version="11.0.0-preview.6.26359.118" />
  </ItemGroup>
</Project>
