
@familyMemberId = 4bc839ac-5be0-4a75-8a9d-6a6630c9d2a7

### List family members
GET {{baseUrl}}/api/family
Accept: application/json
X-Hearth-Secret: {{hearthSecret}}

### Create a family member
# @name createFamilyMember
POST {{baseUrl}}/api/family
Content-Type: application/json
X-Hearth-Secret: {{hearthSecret}}

{
  "name": "papa"
}

> {%
  const payload = response.body?.data ?? response.body;
  if (payload?.id) {
    client.global.set("familyMemberId", payload.id);
  }
%}

### Update a family member
PUT {{baseUrl}}/api/family/{{familyMemberId}}
Content-Type: application/json
X-Hearth-Secret: {{hearthSecret}}

{
  "name": "papa (updated)"
}

### Delete a family member
DELETE {{baseUrl}}/api/family/{{familyMemberId}}
Accept: application/json
X-Hearth-Secret: {{hearthSecret}}
