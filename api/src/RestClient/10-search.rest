# Optional controlled hard-filter comparison: same Supper filter for both chips.
# Run only after the unfiltered baseline above; a restrictive filter may hide matches.

### poultry Main chip with Supper only
POST {{baseUrl}}/api/recipes/search
Accept: application/json
Content-Type: application/json
X-Family-Member-Id: {{familyMemberId}}
X-Hearth-Secret: {{hearthSecret}}

{
  "query": "",
  "limit": 12,
  "filters": {
    "mealTypes": [
      "Supper"
    ]
  },
  "preferences": {
    "concepts": [
      "poultry"
    ]
  }
}

