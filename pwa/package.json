{
  "name": "whats-for-supper-pwa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "python3 ../scripts/agent/kiota_client.py generate",
    "test": "npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:reuse-server": "BASE_URL=${BASE_URL:-http://127.0.0.1:3000} playwright test",
    "test:e2e:planner": "playwright test e2e/planner.spec.ts",
    "test:e2e:planner-full-cycle": "playwright test e2e/planner-full-cycle.spec.ts",
    "test:e2e:utility": "playwright test e2e/utility-flows.spec.ts",
    "test:e2e:home": "playwright test e2e/home-*.spec.ts",
    "test:e2e:capture": "playwright test e2e/capture-flow.spec.ts",
    "test:e2e:discovery": "playwright test e2e/discovery.spec.ts",
    "test:e2e:onboarding": "playwright test e2e/onboarding.spec.ts",
    "test:e2e:recipes": "playwright test e2e/recipes.spec.ts",
    "test:e2e:step-parser": "playwright test e2e/step-parser.spec.ts",
    "test:e2e:ci": "node ../scripts/ci/production-browser.cjs qualify --",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "agent:slice": "python3 ../scripts/agent/slice.py",
    "agent:drift": "python3 ../scripts/agent/drift.py",
    "agent:audit": "cd .. && python3 -B scripts/agent/test_audit.py",
    "agent:test:impact": "python3 ../scripts/agent/test_ops.py --impact",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:coverage": "vitest run --coverage --passWithNoTests",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@microsoft/kiota-abstractions": "^1.0.0-preview.114",
    "@microsoft/kiota-http-fetchlibrary": "^1.0.0-preview.114",
    "@microsoft/kiota-serialization-form": "^1.0.0-preview.114",
    "@microsoft/kiota-serialization-json": "^1.0.0-preview.114",
    "@microsoft/kiota-serialization-multipart": "^1.0.0-preview.114",
    "@microsoft/kiota-serialization-text": "^1.0.0-preview.114",
    "@swc/helpers": "^0.5.24",
    "axios": "^1.21.1",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.76.0",
    "next": "^16.4.6",
    "next-intl": "^4.15.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.7.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=26.12.0 <27",
    "npm": "11.21.x"
  },
  "packageManager": "npm@11.21.1"
}
