{
  "name": "whats-for-supper-pwa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "api:generate": "dotnet kiota generate -l typescript -c ApiClient -o ./src/lib/api/generated -d ../specs/openapi.yaml && node scripts/fix-kiota-imports.js",
    "test": "npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:reuse-server": "BASE_URL=${BASE_URL:-http://127.0.0.1:3000} playwright test",
    "test:e2e:planner": "playwright test e2e/planner.spec.ts",
    "test:e2e:planner-full-cycle": "playwright test e2e/planner-full-cycle.spec.ts",
    "test:e2e:utility": "playwright test e2e/utility-flows.spec.ts",
    "test:e2e:home": "playwright test e2e/home-*.spec.ts",
    "test:e2e:capture": "playwright test e2e/capture-flow.spec.ts",
    "test:e2e:discovery": "playwright test e2e/discovery.spec.ts",
    "test:e2e:onboarding": "playwright test e2e/onboarding.spec.ts",
    "test:e2e:recipes": "playwright test e2e/recipes.spec.ts",
    "test:e2e:step-parser": "playwright test e2e/step-parser.spec.ts",
    "test:e2e:ci": "npm run build && npm run test:e2e",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "agent:slice": "python3 ../scripts/agent/slice.py",
    "agent:drift": "python3 ../scripts/agent/drift.py",
    "agent:audit": "python3 ../scripts/agent/test_ops.py --audit",
    "agent:test:impact": "python3 ../scripts/agent/test_ops.py --impact",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:coverage": "vitest run --coverage --passWithNoTests",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@microsoft/kiota-abstractions": "^1.0.0-preview.103",
    "@microsoft/kiota-http-fetchlibrary": "^1.0.0-preview.103",
    "@microsoft/kiota-serialization-form": "^1.0.0-preview.103",
    "@microsoft/kiota-serialization-json": "^1.0.0-preview.103",
    "@microsoft/kiota-serialization-multipart": "^1.0.0-preview.103",
    "@microsoft/kiota-serialization-text": "^1.0.0-preview.103",
    "@swc/helpers": "^0.5.21",
    "axios": "^1.19.0",
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^12.4.7",
    "lucide-react": "^1.14.0",
    "next": "^16.3.0",
    "next-intl": "^4.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.5.0",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.0",
    "fast-check": "^3.23.2",
    "globals": "^17.6.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.25",
    "prettier": "^3.4.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
