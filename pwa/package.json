{
  "name": "whats-for-supper-pwa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "api:generate": "python3 ../scripts/agent/kiota_client.py generate",
    "test": "npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:reuse-server": "BASE_URL=${BASE_URL:-http://127.0.0.1:3000} playwright test",
    "test:e2e:planner": "playwright test e2e/planner.spec.ts",
    "test:e2e:planner-full-cycle": "playwright test e2e/planner-full-cycle.spec.ts",
    "test:e2e:utility": "playwright test e2e/utility-flows.spec.ts",
    "test:e2e:home": "playwright test e2e/home-*.spec.ts",
    "test:e2e:capture": "playwright test e2e/capture-flow.spec.ts",
    "test:e2e:discovery": "playwright test e2e/discovery.spec.ts",
    "test:e2e:onboarding": "playwright test e2e/onboarding.spec.ts",
    "test:e2e:recipes": "playwright test e2e/recipes.spec.ts",
    "test:e2e:step-parser": "playwright test e2e/step-parser.spec.ts",
    "test:e2e:ci": "npm run build && npm run test:e2e",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "agent:slice": "python3 ../scripts/agent/slice.py",
    "agent:drift": "python3 ../scripts/agent/drift.py",
    "agent:audit": "python3 ../scripts/agent/test_ops.py --audit",
    "agent:test:impact": "python3 ../scripts/agent/test_ops.py --impact",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:coverage": "vitest run --coverage --passWithNoTests",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@microsoft/kiota-abstractions": "^1.0.0-preview.107",
    "@microsoft/kiota-http-fetchlibrary": "^1.0.0-preview.107",
    "@microsoft/kiota-serialization-form": "^1.0.0-preview.107",
    "@microsoft/kiota-serialization-json": "^1.0.0-preview.107",
    "@microsoft/kiota-serialization-multipart": "^1.0.0-preview.107",
    "@microsoft/kiota-serialization-text": "^1.0.0-preview.107",
    "@swc/helpers": "^0.5.23",
    "axios": "^1.20.0",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^13.3.0",
    "lucide-react": "^1.45.0",
    "next": "^16.3.5",
    "next-intl": "^4.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.6.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "fast-check": "^4.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
