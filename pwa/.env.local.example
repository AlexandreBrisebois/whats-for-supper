# PWA Environment Variables (Next.js)

# API URL for client-side requests (relative path — API routes include /api prefix, so base URL should be /)
NEXT_PUBLIC_API_BASE_URL=

# API URL for server-side requests (SSR)
API_INTERNAL_URL=http://localhost:9001

# Environment name
NEXT_PUBLIC_ENVIRONMENT=development

# Hearth Secret: family passphrase used for stateless no-password auth (ADR 027)
# Set to a memorable passphrase shared with your household. Changing this invalidates all existing sessions.
HEARTH_SECRET=your family passphrase here

# Comma-separated list of GrocerySection names. If omitted or invalid, the default order is used.
# Valid sections: Produce, Meat, Seafood, Dairy & Eggs, Frozen, Bakery, Pantry, Beverages, Deli, Grocery
NEXT_PUBLIC_AISLE_ORDER=Produce,Deli,Bakery,Meat,Seafood,Dairy & Eggs,Frozen,Pantry,Beverages,Grocery

# Feature Flags
NEXT_PUBLIC_ENABLE_AGENT_SEARCH=false
NEXT_PUBLIC_ENABLE_PHOTO_SEARCH=false
