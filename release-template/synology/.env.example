# REQUIRED — set before deployment
POSTGRES_PASSWORD=
HEARTH_SECRET=
GEMINI_API_KEY=
CLOUDFLARE_TUNNEL_TOKEN=
ELEVATED_ACTIONS_PIN=

# DEFAULTS — change only when needed
WFS_VERSION=0.1.0-beta.1
WFS_HTTP_PORT=9100
GEMINI_MODEL_ID=gemini-3-flash-preview
GEMINI_MODEL_ID_HERO=models/gemini-3-pro-image-preview
EMBEDDING_MODEL_ID=gemini-embedding-2
DEMO_MODE=false
# off: unavailable; opt-in: per-member Preview features toggle; on: enabled for everyone
WFS_FEATURE_SINGLE_PAGE_RECIPE_STEPS=off

# PDF acquisition and /manifest.json use the same deployment mode in API and PWA.
WFS_FEATURE_PREVIEW_PDF_RECIPE_IMPORT=off
