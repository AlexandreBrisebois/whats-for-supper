# REQUIRED — set before deployment
POSTGRES_PASSWORD=
HEARTH_SECRET=
GEMINI_API_KEY=
ELEVATED_ACTIONS_PIN=

# TUNNEL SCENARIO — setup.sh saves your selection here.
# bundled: compose.yaml:compose.tunnel.yaml (requires the token below)
# shared:  compose.yaml:compose.shared-tunnel.yaml (no app-local token needed)
COMPOSE_FILE=compose.yaml:compose.tunnel.yaml
CLOUDFLARE_TUNNEL_TOKEN=
# Shared mode only: unique proxy alias per deployment; same network as connector.
WFS_PROXY_NETWORK=cloudflare-proxy
WFS_PROXY_ALIAS=

# DEFAULTS — change only when needed
WFS_VERSION=0.1.0-beta.1
WFS_HTTP_PORT=9100
GEMINI_MODEL_ID=gemini-3-flash-preview
GEMINI_MODEL_ID_HERO=models/gemini-3-pro-image-preview
EMBEDDING_MODEL_ID=gemini-embedding-2
DEMO_MODE=false

# Household calendar timezone (IANA identifier). Toronto observes EST/EDT automatically.
Calendar__TimeZone=America/Toronto

# Weekly interest and Dreaming use complete deployment-calendar weeks (1–5200).
HISTORICAL_INTEREST_WEEKS=4
HISTORICAL_INTEREST_ENABLED=true
COOKED_COOLDOWN_WEEKS=4
DREAMING_ROTATION_ENABLED=true
