# Synthetic configuration shared by local and CI smoke tests. No local seed mounts.
POSTGRES_USER=recipe_app
POSTGRES_PASSWORD=ci_password
POSTGRES_DB=recipe_app_db
POSTGRES_CONNECTION_STRING=postgres://recipe_app:ci_password@postgres:5432/recipe_app_db
ASPNETCORE_ENVIRONMENT=Development
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:9001
API_INTERNAL_URL=http://api:9001
HEARTH_SECRET=smoke-test-only
ELEVATED_ACTIONS_PIN=
GEMINI_API_KEY=none
GEMINI_MODEL_ID=gemini-3-flash-preview
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL_ID=text-embedding-3-small
IMPORT_TARGET_LANGUAGE=NONE
DREAMING_CRON_UTC=0 3 * * *
DEMO_MODE=false
DEMO_RESTORE_CRON_UTC=0 3 * * *
DOMAIN_NAME=pwa.wfs.localhost
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_ENABLE_AGENT_SEARCH=false
NEXT_PUBLIC_ENABLE_PHOTO_SEARCH=false
