# What's For Supper - Environment Variables Template
# Copy to .env.local and fill in your local values
# WARNING: Never commit .env.local to git!

# ============================================================================
# CORE SERVICES & INFRASTRUCTURE
# ============================================================================

# Docker Engine Endpoint (Linux/macOS default)
# DOCKER_ENDPOINT=unix:///var/run/docker.sock

# Traefik (Edge Proxy)
TRAEFIK_HTTP_PORT=80
TRAEFIK_ADMIN_PORT=8080

# Cloudflare Tunnel
# Production domain: wfs.srvrlss.dev (single unified domain — API on /backend, PWA on /)
CLOUDFLARE_TUNNEL_TOKEN=
DOMAIN_NAME=srvrlss.dev

# PostgreSQL
POSTGRES_USER=recipe_app
POSTGRES_PASSWORD=secure_dev_password
POSTGRES_DB=recipe_app_db
POSTGRES_PORT=5432
# Connection string used by the API container (Internal network)
POSTGRES_CONNECTION_STRING=postgres://recipe_app:secure_dev_password@postgres:5432/recipe_app_db

# ============================================================================
# API (.NET)
# ============================================================================

# External Hostname (Traefik)
# Production: wfs.srvrlss.dev/api (Traefik routes PathPrefix(`/api`) directly to the API container — no proxy)
# Local dev:  api.wfs.localhost or http://localhost:9001/api (direct)
API_HOST=api.wfs.localhost
# Port for direct access (optional in dev)
API_PORT=9001
ASPNETCORE_ENVIRONMENT=Development
# Internal Docker network URL (used only by Docker health checks and infra; not the browser path)
API_INTERNAL_URL=http://api:9001

# ============================================================================
# PWA (Next.js)
# ============================================================================

# External Hostname (Traefik)
# Production: wfs.srvrlss.dev (root path) | Local: pwa.wfs.localhost
PWA_HOST=pwa.wfs.localhost
# Port for direct access (optional in dev)
PWA_PORT=3000
# API base URL as seen by the browser (the origin only — no /api suffix).
# The generated Kiota client appends /api/... paths automatically.
# Production:  http://wfs.srvrlss.dev  (or leave as / for same-origin via Traefik)
# Local dev:   http://pwa.wfs.localhost (Traefik routes /api/* to the API container)
# Direct dev:  http://localhost:9001    (bypass Traefik, hit API container directly)
NEXT_PUBLIC_API_BASE_URL=http://pwa.wfs.localhost
NEXT_PUBLIC_ENVIRONMENT=development
# Hearth Secret: shared family passphrase for stateless HMAC auth (ADR 027).
# Must be identical in both the PWA (token generation) and the API (token validation).
# Changing this invalidates all existing sessions.
HEARTH_SECRET=your-family-passphrase-here
# Cookie domain for production single-domain deployment.
# Leave empty for local dev (localhost). Set to wfs.srvrlss.dev for production.
NEXT_PUBLIC_COOKIE_DOMAIN=

# ============================================================================
# AI & EXTRACTION (Google Gemini)
# ============================================================================

GEMINI_API_KEY=
# Use models/gemini-3-flash for extraction
GEMINI_MODEL_ID=models/gemini-3-flash
# Optional: Project ID for GCP-based Vertex AI (if applicable)
GEMINI_PROJECT_ID=
# OpenAI-compatible endpoint (defaults to Google's v1beta)
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/

# ============================================================================
# STORAGE & DATA
# ============================================================================

# Recipes Storage (Map to local project root folder)
# Set to a local path (e.g., ../../data) for bind mounting.
DATA_ROOT=../../data

# ============================================================================
# SECURITY & CORS
# ============================================================================

# CORS Origins — used by the .NET API to allow direct browser connections.
# Required when the browser connects directly to the API (e.g. SSE stream).
# Production: https://wfs.srvrlss.dev  |  Local: http://pwa.wfs.localhost,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://pwa.wfs.localhost,http://localhost:3000

# ============================================================================
# LOGGING
# ============================================================================

LOG_LEVEL=Information
LOG_FORMAT=json
