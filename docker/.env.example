# What's For Supper - Environment Variables Template
# Copy to .env.local and fill in your local values
# WARNING: Never commit .env.local to git!

# ============================================================================
# INFRASTRUCTURE & DOMAIN
# ============================================================================

# The primary domain name (e.g., wfs.yourdomain.com)
DOMAIN_NAME=pwa.wfs.localhost

# Cloudflare Tunnel Token (optional, for remote access)
CLOUDFLARE_TUNNEL_TOKEN=

# Traefik (Edge Proxy)
TRAEFIK_HTTP_PORT=80
TRAEFIK_ADMIN_PORT=8080
# Path to the docker socket (default: unix:///var/run/docker.sock)
DOCKER_ENDPOINT=unix:///var/run/docker.sock


# ============================================================================
# PRODUCTION DEPLOYMENT (NAS / Remote)
# ============================================================================

# Container Registry & Versioning
WFS_REGISTRY=brisebois
TAG=latest

# External Port Mappings (Used when bypassing Traefik)
API_PORT_EXTERNAL=9101
PWA_PORT_EXTERNAL=9102
POSTGRES_PORT_EXTERNAL=9103

# ============================================================================
# API (.NET)
# ============================================================================

API_HOST=api
API_PORT=9001
ASPNETCORE_ENVIRONMENT=Development
# Internal network URL for PWA server-side calls
API_INTERNAL_URL=http://api:9001

# ============================================================================
# PWA (Next.js)
# ============================================================================

PWA_HOST=pwa.wfs.localhost
PWA_PORT=3000



# IMPORTANT: In production behind Traefik, this MUST be empty/unset.
# Local dev: http://pwa.wfs.localhost
# Note: NEXT_PUBLIC_* variables are baked at PWA image build time for prebuilt Docker images.
NEXT_PUBLIC_API_BASE_URL=

# Used for cookie scoping. Set to your top-level domain in production.
NEXT_PUBLIC_COOKIE_DOMAIN=

# development | production
NEXT_PUBLIC_ENVIRONMENT=development

# Custom aisle ordering for grocery lists (comma-separated valid GrocerySection values)
NEXT_PUBLIC_AISLE_ORDER=Produce,Deli,Bakery,Meat,Seafood,Dairy & Eggs,Frozen,Pantry,Beverages,Grocery

# Default language (en | fr)
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ============================================================================
# AI & EXTRACTION (Google Gemini — required; no model-free mode exists)
# ============================================================================

GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.8-flash
GEMINI_MODEL_ID_HERO=models/gemini-3-pro-image
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_MAX_OUTPUT_TOKENS=16384

# Automated translation for new imports and reimports.
# Set to 'French', 'English', or 'NONE' (to disable).
IMPORT_TARGET_LANGUAGE=NONE

# ============================================================================
# SEARCH & EMBEDDINGS
# ============================================================================

# Model for vector indexing. Changing this requires a full reindex.
# Default: gemini-embedding-2
EMBEDDING_MODEL_ID=gemini-embedding-2
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_MODEL_VERSION=
# WFS_ENABLE_SEMANTIC_RETRIEVAL=true
# WFS_SEMANTIC_CANDIDATE_LIMIT=50
# WFS_SEARCH_CONFIGURATION_VERSION=hybrid-search-v1

# ============================================================================
# STORAGE & DATA
# ============================================================================

# Root directory for persistent data (bind mount)
DATA_ROOT=../../data

# Optional specific directory overrides (defaults to DATA_ROOT/recipes and DATA_ROOT/workflows)
RECIPES_ROOT=
WORKFLOWS_ROOT=

# UTC cron expression for the nightly Dreaming maintenance workflow.
# Default: 0 6 * * * (06:00 UTC every day)
DREAMING_CRON_UTC=0 6 * * *

# Optional exact recovery (must point to an independent directory outside DATA_ROOT/RECIPES_ROOT)
# Recovery__BackupRoot=
# Recovery__WaitSeconds=5
# Recovery__MaxFreezeSeconds=30

# Optional workflow concurrency and retry tuning (.NET IConfiguration)
# WorkflowThrottle__Default=5
# WorkflowThrottle__ExtractRecipe=1
# WorkflowThrottle__GenerateHero=1
# WorkflowRetry__MaxRetries=10
# WorkflowRetry__QuietWindowStartHour=1
# WorkflowRetry__QuietWindowEndHour=5

# ============================================================================
# SECURITY & AUTH
# ============================================================================

# Comma-separated list of allowed CORS origins.
CORS_ALLOWED_ORIGINS=http://pwa.wfs.localhost,http://localhost:3000

# HMAC secret for family session tokens.
HEARTH_SECRET=your-family-passphrase-here

# PIN required to purge recipes from the Recycle Bin.
ELEVATED_ACTIONS_PIN=

# ============================================================================
# DEMO MODE (Showcase)
# ============================================================================

# Enable demo mode (frozen state, master snapshot resets, AI bypass)
DEMO_MODE=false

# UTC cron expression for the master snapshot restore.
# Default: 0 3 * * * (03:00 UTC every day)
DEMO_RESTORE_CRON_UTC=0 3 * * *

# ============================================================================
# DATABASE
# ============================================================================

POSTGRES_USER=recipe_app
POSTGRES_PASSWORD=secure_dev_password
POSTGRES_DB=recipe_app_db
POSTGRES_PORT=5432
POSTGRES_CONNECTION_STRING=postgres://recipe_app:secure_dev_password@postgres:5432/recipe_app_db

# Administrator-owned supper calendar (IANA timezone); shipped Compose/env templates default to America/Toronto.
Calendar__TimeZone=America/Toronto
# Example override: Calendar__TimeZone=Europe/Paris

# Weekly interest and Dreaming use complete deployment-calendar weeks (1–5200).
HISTORICAL_INTEREST_WEEKS=4
HISTORICAL_INTEREST_ENABLED=true
COOKED_COOLDOWN_WEEKS=4
DREAMING_ROTATION_ENABLED=true
